# Production settings for docker compose (B-33). Copy to .env and fill in. See docs/DEPLOY.md.
APP_NAME="Lab Ordering"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://example.com
APP_PORT=8080
# "*" when a load balancer or reverse proxy in front ends HTTPS.
TRUSTED_PROXIES=*
# Run database migrations when the web container starts.
RUN_MIGRATIONS=true

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lab_ordering
DB_USERNAME=lab_ordering
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Email (any SMTP provider).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Payments: set one provider's keys, then pick it in Admin → Settings.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS and WhatsApp (Twilio).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Map tiles. The free OpenStreetMap tiles are for light use only; set a provider for real traffic.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=
